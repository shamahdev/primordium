{
  "expo": {
    "name": "Primordium",
    "slug": "primordium",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "primordium",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.shamah.primordium"
    },
    "android": {
      "package": "dev.shamah.primordium",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-theme-colors",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D32936",
          "android": {
            "image": "./assets/images/splash.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd80b487-711c-4835-be99-66a95a7ae988"
      }
    }
  }
}
