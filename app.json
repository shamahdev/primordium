{
  "expo": {
    "name": "Primordium",
    "slug": "primordium",
    "version": "0.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6112E",
      "imageWidth": 257
    },
    "scheme": "primordium",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.shamah.primordium"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E6112E"
      },
      "package": "dev.shamah.primordium",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd80b487-711c-4835-be99-66a95a7ae988"
      }
    }
  }
}
