{
  "expo": {
    "name": "Primordium",
    "slug": "primordium",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "primordium",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.shamah.primordium"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#E6112E"
      },
      "package": "dev.shamah.primordium",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6112E",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd80b487-711c-4835-be99-66a95a7ae988"
      }
    }
  }
}
